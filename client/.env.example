# Frontend Configuration - Public/Safe Variables Only (Prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_NAME=Anther Academy

# Supabase - Publishable Key (Public - safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here

# Paystack - Public Key (Public - safe to expose in browser)
# TEST: Get from: Paystack Dashboard > Settings > API Keys & Webhooks > Public Key (starts with pk_test_)
# LIVE: Get from: Paystack Dashboard > Settings > API Keys & Webhooks > Public Key (starts with pk_live_)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_test_public_key
