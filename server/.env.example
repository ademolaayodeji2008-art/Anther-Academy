# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database - Supabase (Secret Key - NEVER expose to frontend or commit to git)
# Get from: Supabase Dashboard > Project Settings > API > Secret Key (starts with sb_secret_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Authentication - JWT
# Generate strong random value: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Payments - Paystack (Secret Key - NEVER expose to frontend)
# TEST: Get from: Paystack Dashboard > Settings > API Keys & Webhooks > Secret Key (starts with sk_test_)
# LIVE: Get from: Paystack Dashboard > Settings > API Keys & Webhooks > Secret Key (starts with sk_live_)
# To switch from TEST to LIVE, just change this one env var (no code changes)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_secret_key

# File Storage - Cloudinary
# Get from: Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email - Gmail SMTP
# Gmail: Generate app password at https://myaccount.google.com/apppasswords (requires 2FA)
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_SMTP_PASS=your-app-specific-password
EMAIL_FROM_NAME=Anther Academy
EMAIL_FROM_ADDRESS=noreply@antheracademy.com
ADMIN_EMAIL=admin@antheracademy.com

# Logging
LOG_LEVEL=debug
